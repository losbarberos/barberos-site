{
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm nx build:*)",
      "Bash(pnpm nx test:*)",
      "Bash(pnpm nx lint:*)",
      "Bash(pnpm nx format:check:*)",
      "Bash(pnpm nx format:write:*)",
      "Bash(pnpm nx run-many:*)",
      "Bash(pnpm nx affected:*)",
      "Bash(pnpm nx show:*)",
      "Bash(pnpm nx graph:*)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)"
    ],
    "ask": [
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm up:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm rm:*)",
      "Bash(pnpm nx migrate:*)",
      "Bash(pnpm migrate:*)",
      "Bash(git push:*)",
      "Bash(gh workflow run:*)",
      "Bash(netlify:*)",
      "Bash(npx netlify:*)",
      "Bash(pnpm dlx netlify:*)",
      "Bash(pnpm exec netlify:*)",
      "Bash(firebase:*)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["/tmp/.nx", "~/.nx"],
      "allowWrite": ["/tmp/.nx", "~/.nx"]
    },
    "network": {
      "allowUnixSockets": ["/tmp/.nx", "~/.nx"]
    }
  }
}
